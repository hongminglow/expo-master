{
  "expo": {
    "name": "Pulse Mobile",
    "slug": "pulse-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pulsemobile",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.pulsemobile.app",
      "buildNumber": "1",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow camera access to scan QR codes.",
        "NSLocationWhenInUseUsageDescription": "Allow location access to show the current device coordinates.",
        "NSPhotoLibraryUsageDescription": "Allow photo library access to select media.",
        "NSUserNotificationsUsageDescription": "Allow notifications to test local and push notification readiness.",
        "NSFaceIDUsageDescription": "Allow Face ID to demonstrate biometric verification."
      }
    },
    "android": {
      "package": "com.pulsemobile.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0D1B2A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access to scan QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow location access to show the current device coordinates."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow photo library access to select media."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B6E4F"
        }
      ],
      "expo-document-picker",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1B2A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
